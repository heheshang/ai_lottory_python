# ===========================================
# PRODUCTION Environment Configuration
# ===========================================
# This is a template for production environment configuration
# Copy to .env.production and fill in your actual production values

# Flask Application Configuration
FLASK_ENV=production
FLASK_DEBUG=false
SECRET_KEY=your-production-secret-key-min-32-chars-secure-random
DATABASE_URL=postgresql://username:password@localhost:5432/lottery_prod_db
SQLALCHEMY_TRACK_MODIFICATIONS=false
SQLALCHEMY_ECHO=false
SQLALCHEMY_POOL_SIZE=20
SQLALCHEMY_POOL_TIMEOUT=30
SQLALCHEMY_POOL_RECYCLE=3600

# AI/ML Services (production keys)
LANGCHAIN_API_KEY=your-production-langchain-api-key
OPENAI_API_KEY=your-production-openai-api-key
HUGGINGFACE_API_KEY=your-production-huggingface-api-key

# Constitutional Compliance (DO NOT CHANGE - Enforced by requirements)
MAX_PREDICTION_CONFIDENCE=0.85
RESPONSIBLE_GAMBLING_REQUIRED=true
ETHICAL_DISCLAIMERS_ENABLED=true
STATISTICAL_VALIDATION_ENABLED=true
CONFIDENCE_INTERVALS_REQUIRED=true
PREDICTION_TRANSPARENCY_REQUIRED=true

# Performance and Rate Limiting
PREDICTION_TIMEOUT=3
DATA_ACCESS_TIMEOUT=30
RATELIMIT_ENABLED=true
RATELIMIT_DEFAULT=100 per hour
RATELIMIT_PREDICTIONS=20 per hour
RATELIMIT_DATA_ACCESS=200 per hour
CACHE_TYPE=redis
CACHE_DEFAULT_TIMEOUT=600
CACHE_REDIS_URL=redis://localhost:6379/1

# Security Configuration
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
WTF_CSRF_ENABLED=true
PERMANENT_SESSION_LIFETIME=3600
CORS_ORIGINS=https://yourdomain.com,https://api.yourdomain.com
JWT_SECRET_KEY=your-production-jwt-secret-key-secure-random
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=86400

# Frontend Configuration
VUE_APP_API_URL=https://api.yourdomain.com/api
VUE_APP_API_TIMEOUT=30000
VUE_APP_ETHICAL_COMPLIANCE_ENABLED=true
VUE_APP_RESPONSIBLE_GAMBLING_ENABLED=true
VUE_APP_PREDICTION_CONFIDENCE_CAP=0.85

# External Service URLs (production)
PROBLEM_GAMBLING_HELPLINE=https://www.ncpgambling.org/help-treatment/problem-gambling-helpline/
RESPONSIBLE_GAMBLING_RESOURCES=https://www.ncpgambling.org/
GAMBLING_ANONYMOUS=https://www.gamblersanonymous.org/
NATIONAL_COUNCIL_ON_PROBLEM_GAMBLING=https://www.ncpgambling.org/

# Monitoring and Logging
LOG_LEVEL=WARNING
LOG_FILE_ENABLED=true
LOG_FILE_PATH=/var/log/lottery_prediction/app.log
LOG_FILE_MAX_BYTES=52428800
LOG_FILE_BACKUP_COUNT=20
MONITORING_ENABLED=true
HEALTH_CHECK_ENABLED=true
METRICS_ENABLED=true
SENTRY_DSN=your-production-sentry-dsn

# Email Configuration (production)
MAIL_SERVER=smtp.yourdomain.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=noreply@yourdomain.com
MAIL_PASSWORD=your-production-email-password
MAIL_DEFAULT_SENDER=noreply@yourdomain.com

# Testing Configuration
TESTING=false
WTF_CSRF_ENABLED=true

# Production Specific Settings
DEVELOPMENT_MODE=false
API_DOCS_ENABLED=false
DEBUG_TOOLBAR_ENABLED=false

# SSL and HTTPS
FORCE_HTTPS=true
SSL_CERT_PATH=/etc/ssl/certs/yourdomain.com.crt
SSL_KEY_PATH=/etc/ssl/private/yourdomain.com.key

# Backup and Maintenance
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30