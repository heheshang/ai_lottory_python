# Environment Configuration for Lottery Prediction Website
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file to version control

# ===========================================
# Flask Application Configuration
# ===========================================
FLASK_ENV=development
SECRET_KEY=your-secret-key-here-change-in-production-min-32-chars
FLASK_DEBUG=true

# Database Configuration
DATABASE_URL=sqlite:///lottery_dev.db
SQLALCHEMY_TRACK_MODIFICATIONS=false
SQLALCHEMY_ECHO=false

# Production Database (uncomment for production)
# DATABASE_URL=postgresql://username:password@localhost:5432/lottery_db
# SQLALCHEMY_POOL_SIZE=10
# SQLALCHEMY_POOL_TIMEOUT=20
# SQLALCHEMY_POOL_RECYCLE=3600

# ===========================================
# AI/ML Services Configuration
# ===========================================
LANGCHAIN_API_KEY=your-langchain-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
HUGGINGFACE_API_KEY=your-huggingface-api-key-here

# ML Model Configuration
ML_MODEL_CACHE_TTL=3600
ML_MAX_CONCURRENT_PREDICTIONS=10
ML_ENABLE_FALLBACK_MODE=true

# ===========================================
# Constitutional Compliance Settings
# ===========================================
# WARNING: These values are enforced by constitutional requirements
# DO NOT MODIFY THESE VALUES WITHOUT ETHICAL REVIEW
MAX_PREDICTION_CONFIDENCE=0.85
RESPONSIBLE_GAMBLING_REQUIRED=true
ETHICAL_DISCLAIMERS_ENABLED=true
STATISTICAL_VALIDATION_ENABLED=true
CONFIDENCE_INTERVALS_REQUIRED=true
PREDICTION_TRANSPARENCY_REQUIRED=true

# ===========================================
# Performance and Rate Limiting
# ===========================================
PREDICTION_TIMEOUT=3
DATA_ACCESS_TIMEOUT=30
RATELIMIT_ENABLED=true
RATELIMIT_DEFAULT=100 per hour
RATELIMIT_PREDICTIONS=20 per hour
RATELIMIT_DATA_ACCESS=200 per hour

# Cache Configuration
CACHE_TYPE=simple
CACHE_DEFAULT_TIMEOUT=300
CACHE_REDIS_URL=redis://localhost:6379/1

# ===========================================
# Security Configuration
# ===========================================
# Production Security Settings (uncomment for production)
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_HTTPONLY=true
# SESSION_COOKIE_SAMESITE=Lax
# WTF_CSRF_ENABLED=true
# PERMANENT_SESSION_LIFETIME=3600

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:8080

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-here-different-from-flask-secret
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=86400

# ===========================================
# Frontend Configuration
# ===========================================
VUE_APP_API_URL=http://localhost:5000/api
VUE_APP_API_TIMEOUT=30000
VUE_APP_ETHICAL_COMPLIANCE_ENABLED=true
VUE_APP_RESPONSIBLE_GAMBLING_ENABLED=true
VUE_APP_PREDICTION_CONFIDENCE_CAP=0.85

# ===========================================
# External Service URLs
# ===========================================
PROBLEM_GAMBLING_HELPLINE=https://www.ncpgambling.org/help-treatment/problem-gambling-helpline/
RESPONSIBLE_GAMBLING_RESOURCES=https://www.ncpgambling.org/
GAMBLING_ANONYMOUS=https://www.gamblersanonymous.org/
NATIONAL_COUNCIL_ON_PROBLEM_GAMBLING=https://www.ncpgambling.org/

# ===========================================
# Monitoring and Logging
# ===========================================
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s %(levelname)s %(name)s: %(message)s
LOG_FILE_ENABLED=true
LOG_FILE_PATH=logs/lottery_prediction.log
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=10

# Monitoring Configuration
MONITORING_ENABLED=false
HEALTH_CHECK_ENABLED=true
METRICS_ENABLED=false
# SENTRY_DSN=your-sentry-dsn-here
# GOOGLE_ANALYTICS_ID=your-ga-id-here

# ===========================================
# Email Configuration (for notifications)
# ===========================================
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# ===========================================
# Testing Configuration
# ===========================================
TESTING=false
TEST_DATABASE_URL=sqlite:///:memory:
WTF_CSRF_ENABLED=false

# ===========================================
# Development Specific Settings
# ===========================================
DEVELOPMENT_MODE=true
API_DOCS_ENABLED=true
DEBUG_TOOLBAR_ENABLED=false
FLASK_ENV=development