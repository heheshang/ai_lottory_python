# ===========================================
# TESTING Environment Configuration
# ===========================================
# This configuration is used for automated testing

# Flask Application Configuration
FLASK_ENV=testing
FLASK_DEBUG=false
TESTING=true
SECRET_KEY=test-secret-key-for-testing-only
DATABASE_URL=sqlite:///:memory:
SQLALCHEMY_TRACK_MODIFICATIONS=false
SQLALCHEMY_ECHO=false

# AI/ML Services (test/mock keys)
LANGCHAIN_API_KEY=test-langchain-key
OPENAI_API_KEY=test-openai-key
HUGGINGFACE_API_KEY=test-huggingface-key

# Constitutional Compliance (maintain production values for testing)
MAX_PREDICTION_CONFIDENCE=0.85
RESPONSIBLE_GAMBLING_REQUIRED=true
ETHICAL_DISCLAIMERS_ENABLED=true
STATISTICAL_VALIDATION_ENABLED=true
CONFIDENCE_INTERVALS_REQUIRED=true
PREDICTION_TRANSPARENCY_REQUIRED=true

# Performance and Rate Limiting (relaxed for testing)
PREDICTION_TIMEOUT=5
DATA_ACCESS_TIMEOUT=10
RATELIMIT_ENABLED=false
CACHE_TYPE=null
CACHE_DEFAULT_TIMEOUT=0

# Security Configuration (relaxed for testing)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
JWT_SECRET_KEY=test-jwt-secret-key-for-testing
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=86400
WTF_CSRF_ENABLED=false

# Frontend Configuration
VUE_APP_API_URL=http://localhost:5000/api
VUE_APP_API_TIMEOUT=10000
VUE_APP_ETHICAL_COMPLIANCE_ENABLED=true
VUE_APP_RESPONSIBLE_GAMBLING_ENABLED=true
VUE_APP_PREDICTION_CONFIDENCE_CAP=0.85

# Monitoring and Logging (minimal for testing)
LOG_LEVEL=ERROR
LOG_FILE_ENABLED=false
MONITORING_ENABLED=false
HEALTH_CHECK_ENABLED=false

# Testing Specific Settings
TEST_DATABASE_URL=sqlite:///:memory:
TESTING=true
DEVELOPMENT_MODE=false
API_DOCS_ENABLED=false
DEBUG_TOOLBAR_ENABLED=false

# Test Data Configuration
TEST_DATA_ENABLED=true
TEST_LOTTERY_DRANS_COUNT=100
TEST_USER_COUNT=10

# Mock External Services
MOCK_EXTERNAL_APIS=true
MOCK_EMAIL_SERVICE=true
MOCK_AI_SERVICES=true